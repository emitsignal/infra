# Bucket that holds the dumps. Falls back to S3_PRIVATE_BUCKET_NAME.
BACKUP_BUCKET="emitsignal-infra"
BACKUP_PREFIX="db-backups"

# Database to dump/restore. Local dev value shown; point this at production to
# back up production. A local host is reached via the host network namespace
# (Linux) or host.docker.internal (macOS).
DATABASE_URL="postgresql://emitsignal:emitsignal@localhost:5432/emitsignal"

# ── Notifications (optional) ──────────────────────────────────────────────────
# Publish backup/restore outcomes to an EmitSignal topic. Leave EMITSIGNAL_TOPIC
# empty to disable notifications entirely — nothing else here is read then.
# Without an API key the publish is anonymous, which is rate limited and cannot
# reach a private topic, so set one for unattended (crontab) runs.
EMITSIGNAL_TOPIC=""
EMITSIGNAL_API_KEY=""
EMITSIGNAL_API_URL="https://api.emitsignal.com"

S3_ACCESS_KEY_ID=""
S3_ENDPOINT=""
S3_REGION="auto" # R2 ignores region; "auto" is the convention.
S3_SECRET_ACCESS_KEY=""

# Docker image used to run pg_dump/pg_restore — keep in sync with the DB version.
POSTGRES_IMAGE="postgres:16-alpine"
