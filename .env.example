# Bucket that holds the dumps. Falls back to S3_PRIVATE_BUCKET_NAME.
BACKUP_BUCKET="emitsignal-infra"
BACKUP_PREFIX="db-backups"

# Database to dump/restore. Local dev value shown; point this at production to
# back up production. localhost is auto-routed to host.docker.internal.
DATABASE_URL="postgresql://emitsignal:emitsignal@localhost:5432/emitsignal"

S3_ACCESS_KEY_ID=""
S3_ENDPOINT=""
S3_REGION="auto" # R2 ignores region; "auto" is the convention.
S3_SECRET_ACCESS_KEY=""

# Docker image used to run pg_dump/pg_restore — keep in sync with the DB version.
POSTGRES_IMAGE="postgres:16-alpine"
